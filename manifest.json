{
  "manifest_version": 3,
  "name": "OmniPedia",
  "version": "0.1.0",
  "description": "Inserts labelled translations of information from other Wikipedia languages when it is missing from the English article.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.wikipedia.org/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://en.wikipedia.org/wiki/*"
      ],
      "js": [
        "content/lib.js",
        "content/wiki.js",
        "content/translate.js",
        "content/inject.js",
        "content/main.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OmniPedia"
  }
}
